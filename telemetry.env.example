# Copy to .env.telemetry (git-ignored) and set your collector. scripts/story-run.sh loads it.
# Never commit a real token.

OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# Shows names like test-writer on token and cost metrics, instead of "custom".
# It can also put more tool detail in events, so check this against your data policy.
OTEL_LOG_TOOL_DETAILS=1

# Prompts and responses stay redacted unless you also set OTEL_LOG_USER_PROMPTS
# or OTEL_LOG_ASSISTANT_RESPONSES. Leave those off unless your policy allows them.
